# Copiar como .env y completar. El .env NO se versiona.
#
# Lo más simple en otra máquina (Google AI Studio):
#   GEMINI_AUTH=api_key
#   GEMINI_API_KEY=
#
# Vertex AI (cuenta de Google Cloud propia):
#   gcloud auth application-default login
#   GEMINI_AUTH=vertex
#   GEMINI_PROJECT=tu-proyecto
#   GEMINI_LOCATION=us-central1
#
# Si GOOGLE_APPLICATION_CREDENTIALS apunta a OTRO proyecto, el cliente
# la ignora y usa el ADC. Para forzar esa cuenta de servicio: GEMINI_USAR_SA=1

GEMINI_AUTH=api_key
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
GEMINI_HILOS=8
